extends Node
## Autoload "Audio": short sound effects and Resonance chords (one bell note per
## relic element), plus a looping music track. Respects the "sfx" and "music"
## settings. A small player pool lets sounds overlap. Sounds live in
## res://assets/audio/<name>.wav; music in music_<track>.wav (generated by
## tools/audio/gen_music.py, replaceable by keeping the file names).

const POOL_SIZE := 10
## Minimum seconds between two plays of the same sound (avoids walls of noise).
const MIN_GAP := 0.05
const MUSIC_DB := -10.0

var _players: Array[AudioStreamPlayer] = []
var _streams: Dictionary = {}
var _last_played: Dictionary = {}
var _next: int = 0
var _music: AudioStreamPlayer
## The track the game wants ("camp", "delve"), even while music is switched off.
var current_music: String = ""


func _ready() -> void:
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	_music = AudioStreamPlayer.new()
	_music.volume_db = MUSIC_DB
	add_child(_music)
	var game := get_node_or_null("/root/Game")
	if game != null:
		game.settings_changed.connect(_apply_music)


## Plays a looping music track; asking for the current track keeps it playing.
func play_music(track: String) -> void:
	if track == current_music and (_music.playing or not _music_enabled()):
		return
	current_music = track
	_apply_music()


func is_music_playing() -> bool:
	return _music != null and _music.playing


func _apply_music() -> void:
	var stream := _stream("music_" + current_music) if not current_music.is_empty() else null
	if not _music_enabled() or stream == null:
		_music.stop()
		return
	if _music.stream != stream or not _music.playing:
		_music.stream = stream
		_music.play()


func _music_enabled() -> bool:
	var game := get_node_or_null("/root/Game")
	return game == null or bool(game.settings.get("music", true))


func play(sound: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	if not _enabled():
		return
	var now := Time.get_ticks_msec() / 1000.0
	if now - float(_last_played.get(sound, -1.0)) < MIN_GAP:
		return
	_last_played[sound] = now
	var stream := _stream(sound)
	if stream == null or _players.is_empty():
		return
	var p := _players[_next]
	_next = (_next + 1) % _players.size()
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.play()


## Plays the notes of the given element tags together.
func play_chord(tags: Array) -> void:
	for tag: String in tags:
		_last_played.erase("note_" + tag)
		play("note_" + tag, -6.0)


func _enabled() -> bool:
	var game := get_node_or_null("/root/Game")
	return game == null or bool(game.settings.get("sfx", true))


func _stream(sound: String) -> AudioStream:
	if not _streams.has(sound):
		var path := "res://assets/audio/%s.wav" % sound
		_streams[sound] = load(path) if ResourceLoader.exists(path) else null
	return _streams[sound]


func _exit_tree() -> void:
	# Release streams so no resources are reported in use at exit.
	if _music != null:
		_music.stop()
		_music.stream = null
	for p in _players:
		p.stream = null
	_streams.clear()
